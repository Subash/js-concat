{
  "name": "js-concat",
  "version": "9.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Concatenate js files with sourcemaps.",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "scripts": {
    "clean-lib": "rimraf lib",
    "clean": "npm run clean-lib",
    "compile-src": "esbuild src/index.js --outfile=lib/index.js --bundle --format=esm --platform=node --packages=external --target=node18",
    "prepack": "npm run clean && npm run compile-src",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "watch": "npm run compile-src -- --watch --sourcemap=inline"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "fixtures"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Subash/js-concat.git"
  },
  "author": "Subash Pathak",
  "bugs": {
    "url": "https://github.com/Subash/js-concat/issues"
  },
  "homepage": "https://github.com/Subash/js-concat#readme",
  "dependencies": {
    "source-map": "^0.7.4"
  },
  "devDependencies": {
    "esbuild": "^0.20.2",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5"
  }
}
